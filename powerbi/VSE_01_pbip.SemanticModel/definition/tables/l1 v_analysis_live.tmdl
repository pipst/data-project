	column unit =
			
			IF(
			    SEARCH("(", 'l1 v_analysis_live'[test_description], 1, 0) > 0,
			    MID(
			        'l1 v_analysis_live'[test_description],
			        SEARCH("(", 'l1 v_analysis_live'[test_description]) + 1,
			        SEARCH(")", 'l1 v_analysis_live'[test_description]) - SEARCH("(", 'l1 v_analysis_live'[test_description]) - 1
			    ),
			    BLANK()
			)
		lineageTag: f9ed87b1-58d6-40df-b366-134d33beecdb
