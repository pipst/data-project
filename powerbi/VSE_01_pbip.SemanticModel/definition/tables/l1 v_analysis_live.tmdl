table 'l1 v_analysis_live'
	lineageTag: 0269775b-5475-460a-ba6f-cd3af3539982

	measure 'Current Product' =
			
			CALCULATE(
			    LASTNONBLANK('l1 v_analysis_live'[product_id], 1),
			    FILTER(ALL('l1 v_analysis_live'),
			           'l1 v_analysis_live'[timestamp] = CALCULATE(MAX('l1 v_analysis_live'[timestamp]), ALL('l1 v_analysis_live')))
			)
		formatString: 0
		lineageTag: eb3bcf83-4b2e-455e-8f76-c54a18ea5263

	measure 'Batch Start' =
			
			CALCULATE(
			    MAX('l1 v_analysis_live'[timestamp]),
			    FILTER(
			        ALL('l1 v_analysis_live'),
			        'l1 v_analysis_live'[product_id] <> [Current Product]
			    )
			)
		formatString: General Date
		lineageTag: 5dee3267-bc56-4135-ae33-29c0be95c059

	measure 'Is Latest Product' =
			
			IF(SELECTEDVALUE('l1 v_analysis_live'[product_id]) = [Current Product], 1, 0)
		formatString: 0
		lineageTag: be1a7376-a2ec-4f88-8569-2315909d3049

	measure 'LSL Live' = MEDIAN('l1 v_analysis_live'[limit_min])
		lineageTag: 0d9507f2-4fa0-4339-983a-432363085bb5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'USL Live' = MEDIAN('l1 v_analysis_live'[limit_max])
		lineageTag: 97c340c2-3ae2-4ec5-9404-bfaac415f006

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mean Live' = AVERAGE('l1 v_analysis_live'[measured_value])
		lineageTag: c0eded02-70c6-4d91-8c6b-9aba5e135370

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Chart Title Live' = ```
			
			SELECTEDVALUE('l1 v_analysis_live'[test_num]) & " - " & 
			SELECTEDVALUE('l1 v_analysis_live'[test_description]) & "; " & 
			SELECTEDVALUE('l1 v_analysis_live'[product_group])
			```
		lineageTag: b3d420b4-4b66-48fa-a0be-a5b16447acb7

	measure 'Current Product Label' =
			
			VAR pid = CALCULATE(
			    LASTNONBLANK('l1 v_analysis_live'[product_id], 1),
			    FILTER(ALL('l1 v_analysis_live'),
			           'l1 v_analysis_live'[timestamp] = CALCULATE(MAX('l1 v_analysis_live'[timestamp]), ALL('l1 v_analysis_live')))
			)
			VAR pgroup = CALCULATE(
			    LASTNONBLANK('l1 v_analysis_live'[product_group], 1),
			    FILTER(ALL('l1 v_analysis_live'),
			           'l1 v_analysis_live'[timestamp] = CALCULATE(MAX('l1 v_analysis_live'[timestamp]), ALL('l1 v_analysis_live')))
			)
			RETURN pgroup & " | " & pid
		lineageTag: 06fc0089-ee3f-418d-9134-11e717762cfb

