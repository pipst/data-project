	column unit =
			
			IF(
			    SEARCH("(", 'l1 v_analysis'[test_description], 1, 0) > 0,
			    MID(
			        'l1 v_analysis'[test_description],
			        SEARCH("(", 'l1 v_analysis'[test_description]) + 1,
			        SEARCH(")", 'l1 v_analysis'[test_description]) - SEARCH("(", 'l1 v_analysis'[test_description]) - 1
			    ),
			    BLANK()
			)
		lineageTag: 91a4a091-c2a0-4e45-b3ab-71a28c830b61
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

