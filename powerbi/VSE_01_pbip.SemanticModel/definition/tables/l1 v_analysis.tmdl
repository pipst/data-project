table 'l1 v_analysis'
	lineageTag: e7d5238e-92fe-46e0-94b1-90d8bbbb563a

	measure LSL = MEDIAN('l1 v_analysis'[limit_min])
		lineageTag: 8a03a127-0288-4975-8d96-aa57eaefb698

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure USL = MEDIAN('l1 v_analysis'[limit_max])
		lineageTag: 567f5fee-b9c1-42ee-be39-56063ccfc745

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Line Chart Title' = ```
			
			SELECTEDVALUE('l1 v_analysis'[test_num]) & " - " & 
			SELECTEDVALUE('l1 v_analysis'[test_description]) & "; " & 
			SELECTEDVALUE('l1 v_analysis'[product_group]) & "; MLFB: " & 
			SELECTEDVALUE('l1 v_analysis'[product_id])
			```
		lineageTag: 0a75e38b-6b71-43c0-8ae7-e6c0f876bc19

	measure 'Count of Tests' =
			
			VAR total = DISTINCTCOUNT('l1 v_analysis'[id])
			RETURN IF(total = 0, BLANK(), total)
		formatString: 0
		lineageTag: 60caa8c4-b55a-403e-bc47-1b56526e5f72

	measure 'First Pass Count' =
			
			CALCULATE(
			    DISTINCTCOUNT('l1 v_analysis'[pu_id]),
			    'l1 v_analysis'[loop_counter] = 1
			)
		formatString: 0
		lineageTag: b7c6caa1-74c8-4c0c-add3-751d867d908c

	measure 'Retested Count' =
			
			CALCULATE(
			    DISTINCTCOUNT('l1 v_analysis'[pu_id]),
			    'l1 v_analysis'[loop_counter] > 1
			)
		formatString: 0
		lineageTag: b6765ea3-4a44-49d2-b270-412ef0f53617

	measure FPY = ```
			
			VAR passes = CALCULATE(
			    DISTINCTCOUNT('l1 v_analysis'[pu_id]),
			    'l1 v_analysis'[fresult] = 1,
			    'l1 v_analysis'[loop_counter] = 1
			)
			
			VAR total = CALCULATE(
			    DISTINCTCOUNT('l1 v_analysis'[pu_id]),
			    'l1 v_analysis'[loop_counter] = 1
			)
			
			RETURN 
			    IF(
			        ISBLANK(total), 
			        BLANK(), 
			        DIVIDE(passes, total)
			    )
			```
		lineageTag: 9d88b7f2-5ff6-40f3-bf16-86608842207f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quality Loss Min' =
			
			CALCULATE(
			    DIVIDE(
			        SUMX(
			            VALUES('l1 v_analysis'[id]),
			            CALCULATE(AVERAGE('l1 v_analysis'[cycle_time_ms]))
			        ),
			        60000
			    ),
			    'l1 v_analysis'[loop_counter] > 1
			)
		lineageTag: d93c1816-17dd-4ce3-aced-144383d9c762

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Machine Time Min' =
			
			CALCULATE(
			    SUMX(
			        SUMMARIZE('l1 v_analysis', 'l1 v_analysis'[id], 'l1 v_analysis'[cycle_time_ms]),
			        'l1 v_analysis'[cycle_time_ms]
			    ) / 60000,
			    'l1 v_analysis'[loop_counter] = 1
			)
		lineageTag: 25f4c234-ce3b-4a30-bc83-fa2ed75e1335

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Error Rate' =
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('l1 v_analysis'[id]),
			        'l1 v_analysis'[fresult] = 0
			    ),
			    CALCULATE(
			        DISTINCTCOUNT('l1 v_analysis'[id]),
			        ALL('l1 v_analysis'[fresult]),
			        ALL('l1 v_analysis'[error_code]),
			        ALL('l1 v_analysis'[error_text]),
			        ALL('l1 v_analysis'[error_label])
			    )
			)
		lineageTag: 944e0b6a-4eb3-42a0-8a82-af8bcd52435c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Error Label' = ```
			
			DISTINCTCOUNT('l1 v_analysis'[id]) & "   " & 
			FORMAT([Error Rate], "0.00 %")
			```
		lineageTag: ee35fb42-b934-4cea-b074-6cc02bace2e4

	measure 'Mean Plus 3 Sigma' =
			
			AVERAGE('l1 v_analysis'[measured_value]) + 3 * STDEV.S('l1 v_analysis'[measured_value])
		lineageTag: aa90d785-ffc8-4e42-aea2-d27ce132eb06

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mean Minus 3 Sigma' =
			
			AVERAGE('l1 v_analysis'[measured_value]) - 3 * STDEV.S('l1 v_analysis'[measured_value])
		lineageTag: 5df7a4d7-a8e8-4f72-bd97-42cc61cff6b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

