            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"data\": {\"name\": \"dataset\"},\n  \"title\": {\n    \"text\": {\"expr\": \"data(''dataset'')[0][''test_num''] + '' - '' + data(''dataset'')[0][''test_description''] + ''; '' + data(''dataset'')[0][''product_group''] + ''; MLFB: '' + data(''dataset'')[0][''product_id'']\"},\n    \"anchor\": \"middle\",\n    \"fontSize\": 11\n  },\n  \"layer\": [\n    {\n      \"mark\": {\"type\": \"bar\", \"color\": \"#0072C6\"},\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"measured_value\",\n          \"type\": \"quantitative\",\n          \"bin\": {\"maxbins\": 20},\n          \"title\": \"Measured value\"\n        },\n        \"y\": {\n          \"aggregate\": \"count\",\n          \"title\": \"Count\"\n        }\n      }\n    },\n    {\n      \"mark\": {\"type\": \"rule\", \"color\": \"red\", \"strokeDash\": [4,4], \"size\": 2},\n      \"encoding\": {\n        \"x\": {\"aggregate\": \"min\", \"field\": \"limit_min\", \"type\": \"quantitative\"}\n      }\n    },\n    {\n      \"mark\": {\"type\": \"rule\", \"color\": \"red\", \"strokeDash\": [4,4], \"size\": 2},\n      \"encoding\": {\n        \"x\": {\"aggregate\": \"min\", \"field\": \"limit_max\", \"type\": \"quantitative\"}\n      }\n    },\n    {\n      \"mark\": {\"type\": \"rule\", \"color\": \"green\", \"size\": 2},\n      \"encoding\": {\n        \"x\": {\"aggregate\": \"mean\", \"field\": \"measured_value\", \"type\": \"quantitative\"}\n      }\n    },\n    {\n      \"transform\": [\n        {\n          \"aggregate\": [\n            {\"op\": \"mean\", \"field\": \"measured_value\", \"as\": \"mean_val\"},\n            {\"op\": \"stdev\", \"field\": \"measured_value\", \"as\": \"std_val\"}\n          ]\n        },\n        {\"calculate\": \"datum.mean_val - 3 * datum.std_val\", \"as\": \"minus3sigma\"}\n      ],\n      \"mark\": {\"type\": \"rule\", \"color\": \"orange\", \"strokeDash\": [2,2], \"size\": 1.5},\n      \"encoding\": {\n        \"x\": {\"field\": \"minus3sigma\", \"type\": \"quantitative\"}\n      }\n    },\n    {\n      \"transform\": [\n        {\n          \"aggregate\": [\n            {\"op\": \"mean\", \"field\": \"measured_value\", \"as\": \"mean_val\"},\n            {\"op\": \"stdev\", \"field\": \"measured_value\", \"as\": \"std_val\"}\n          ]\n        },\n        {\"calculate\": \"datum.mean_val + 3 * datum.std_val\", \"as\": \"plus3sigma\"}\n      ],\n      \"mark\": {\"type\": \"rule\", \"color\": \"orange\", \"strokeDash\": [2,2], \"size\": 1.5},\n      \"encoding\": {\n        \"x\": {\"field\": \"plus3sigma\", \"type\": \"quantitative\"}\n      }\n    }\n  ]\n}'"
